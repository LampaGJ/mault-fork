# Local self-hosted config - AUTH_PROVIDER=local.
#
#   cp .env.local.example .env
#   # then fill the two secrets below
#
# Nothing here talks to mault.xyz, Neon, or Stripe. .env.example is the full
# reference for every variable and the Neon path; this file is just the local
# path with the values already filled in.

# ---- App ------------------------------------------------------------------
# 5173 for `pnpm dev`. Use http://localhost:8080 for `docker compose up`.
WEB_URL=http://localhost:5173
PORT=3001
VITE_APP_ENV=local
VITE_LATEST_FIRMWARE_VERSION=1.0.1

# ---- Auth: fully self-hosted ----------------------------------------------
# own-auth against your own Postgres. No external account, and it also turns
# billing off - see isBillingEnabled() in packages/server/src/lib/stripe.ts,
# so there is no daily scan cap in this mode.
AUTH_PROVIDER=local
VITE_AUTH_PROVIDER=local

# ---- Database -------------------------------------------------------------
# Matches docker-compose's postgres service (pgvector/pgvector:pg17).
# Use @postgres:5432 instead of @localhost:5432 when the server runs in Docker.
DATABASE_URL=postgresql://mault:mault@localhost:5432/mault
DATABASE_SSL=false
POSTGRES_PASSWORD=mault

# ---- Secrets: generate these, do not commit them ---------------------------
# Both are plain random strings. Generate each with:
#
#   openssl rand -hex 32
#
# OWN_AUTH_TOKEN_PEPPER hashes sessions, tokens and API keys - changing it
# later logs everyone out. Left blank on purpose: this file is committed to a
# public repo, so a shared value here would be a shared password.
OWN_AUTH_TOKEN_PEPPER=
IMPERSONATION_SECRET=

# ---- Sync tuning ----------------------------------------------------------
# .env.example ships VECTORIZE_CONCURRENCY=1, which makes a full 9,185-card SWU
# sync painfully slow. The code's own default is 10.
VECTORIZE_CONCURRENCY=10
SYNC_INSERT_BATCH_SIZE=50
SCAN_VECTORIZE_CONCURRENCY=2

# ---- Deliberately unset ---------------------------------------------------
# Stripe: unset means billing is disabled outright, every org unlimited.
# Resend: unset means org invites work as shareable links instead of email.
# Discord: unset means the bot simply is not run.
